datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  cars      Car[]
  bookings  Booking[]
}

model Car {
  id          Int      @id @default(autoincrement())
  vendor      User     @relation(fields: [vendorId], references: [id])
  vendorId    Int
  model       String
  brand       String
  pricePerDay Float
  available   Boolean  @default(true)
  bookings    Booking[]
}

model Booking {
  id         Int      @id @default(autoincrement())
  customer   User     @relation(fields: [customerId], references: [id])
  customerId Int
  car        Car      @relation(fields: [carId], references: [id])
  carId      Int
  startDate  DateTime
  endDate    DateTime
  status     String   @default("pending")
  payment    Payment?
}

model Payment {
  id        Int      @id @default(autoincrement())
  booking   Booking  @relation(fields: [bookingId], references: [id])
  bookingId Int      @unique   // 👈 ensure 1-to-1
  amount    Float
  method    String
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

enum Role {
  customer
  vendor
  admin
}
